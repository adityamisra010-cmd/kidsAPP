# Copy to .env. Without these the app runs in Demo Mode only (that is fine for pitching).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: crash reporting (left disabled when empty)
EXPO_PUBLIC_SENTRY_DSN=

# Optional: Android build overrides
ANDROID_PACKAGE=
GOOGLE_SERVICES_JSON=

# Release signing (keystore lives OUTSIDE the repo; see README "Signing")
MYKIDS_KEYSTORE_PATH=
MYKIDS_KEYSTORE_PASSWORD=
MYKIDS_KEY_ALIAS=
MYKIDS_KEY_PASSWORD=
